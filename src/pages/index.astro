---
import Layout from "../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import logoPng from "../assets/images/logo.png";
import mainBgPng from "../assets/images/main-bg.png";
import newerBgJpg from "../assets/images/newer-bg-image.jpg";
import welcomePng from "../assets/images/welcome-img6.png";
import secondBgPng from "../assets/images/second-bg.png";
import desktopBgPng from "../assets/images/desktop-bg.png";
import heroArtPng from "../assets/images/hero-art.png";
import hPuppy from "../assets/images/helpers/puppy.png";
import hKitty from "../assets/images/helpers/kitty.png";
import hOwl from "../assets/images/helpers/owl.png";
import hDolphin from "../assets/images/helpers/dolphin.png";
import hFairy from "../assets/images/helpers/fairy.png";
import hDragon from "../assets/images/helpers/dragon.png";
import tFairyTales from "../assets/images/themes/fairy-tales.png";
import tDragons from "../assets/images/themes/dragons.png";
import tOcean from "../assets/images/themes/ocean.png";
import tDinosaurs from "../assets/images/themes/dinosaurs.png";
import tSpace from "../assets/images/themes/space.png";
import tPirates from "../assets/images/themes/pirates.png";
import s1 from "../assets/images/screenshots/preview-1.jpg";
import s2 from "../assets/images/screenshots/preview-2.jpg";
import s3 from "../assets/images/screenshots/preview-3.jpg";
import s4 from "../assets/images/screenshots/preview-4.jpg";
import s5 from "../assets/images/screenshots/preview-5.jpg";
import s6 from "../assets/images/screenshots/preview-6.jpg";
import s7 from "../assets/images/screenshots/preview-7.jpg";
import s8 from "../assets/images/screenshots/preview-8.jpg";

const faqs = [
	{
		q: "What is Simbi?",
		a: "Simbi is a personalised bedtime story app where your child becomes the hero. You create their character, choose a magical world and a story helper, and Simbi creates a fresh bedtime story for them each night.",
	},
	{
		q: "How does personalisation work?",
		a: "You create your child's character by choosing features like hair, eyes, skin tone, and pyjamas. You can then pick a story world and a helper companion. Simbi uses these choices to create stories that feel personal to your child.",
	},
	{
		q: "What age is Simbi designed for?",
		a: "Simbi is designed for children aged 2–10. Stories are shaped around your child's age, so younger children get simpler, gentler bedtime stories, while older children can enjoy richer adventures.",
	},
	{
		q: "Do I need to write the stories myself?",
		a: "No. Once your child's profile is set up, Simbi creates the stories for you. There is no story writing or prep needed from you.",
	},
	{
		q: "How often do children get a story?",
		a: "Each child on your account can enjoy 1 story per night.",
	},
	{
		q: "Can I add more than one child?",
		a: "Yes. Simbi is designed for families, so you can add multiple children to the same family account.",
	},
	{
		q: "Can family members use Simbi on multiple devices?",
		a: "Yes. Your family account can be used across multiple devices. You can generate a join code inside the app so other family members or devices can join the same family account.",
	},
	{
		q: "Is Simbi available on iPhone and iPad?",
		a: "Yes. Simbi is available on the App Store for both iPhone and iPad.",
	},
	{
		q: "Can I try Simbi before subscribing?",
		a: "Yes. Each new family gets the first day free, so you can try Simbi and create bedtime stories before deciding whether to subscribe.",
	},
	{
		q: "Does Simbi require a subscription?",
		a: "A subscription is required to continue creating new stories after the free first day. Subscription options are shown clearly in the app.",
	},
	{
		q: "Does Simbi include audio narration?",
		a: "Yes. All plans include audio narration, so you can either read the story together or listen at bedtime.",
	},
	{
		q: "Can siblings have their own stories?",
		a: "Yes. Each child on the account can have their own personalised story experience, based on their profile and choices.",
	},
	{
		q: "Are the stories the same every night?",
		a: "No. Simbi creates a new story each night, so bedtime stays fresh, magical, and personal.",
	},
	{
		q: "What makes Simbi different from regular bedtime story apps?",
		a: "Simbi is built around your child. Instead of choosing from a fixed library of stories, your child becomes the hero of a new personalised adventure each night.",
	},
	{
		q: "Is Simbi designed for parents and families?",
		a: "Yes. Simbi is made for family bedtime routines, with child-friendly storytelling and simple setup for parents or guardians.",
	},
];

const welcomeLcpPreload = await getImage({ src: welcomePng, width: 1200, format: "webp", quality: 84 });

const helpers = [
	{ name: "Biscuit", img: hPuppy, trait: "Loyal & playful" },
	{ name: "Whiskers", img: hKitty, trait: "Curious & gentle" },
	{ name: "Hoot", img: hOwl, trait: "Wise & calm" },
	{ name: "Splash", img: hDolphin, trait: "Brave & kind" },
	{ name: "Twinkle", img: hFairy, trait: "Magical & caring" },
	{ name: "Ember", img: hDragon, trait: "Friendly & fearless" },
];

const themes = [
	{ name: "Fairy Tales", img: tFairyTales },
	{ name: "Friendly Dragons", img: tDragons },
	{ name: "Ocean Adventures", img: tOcean },
	{ name: "Dinosaurs", img: tDinosaurs },
	{ name: "Space Explorers", img: tSpace },
	{ name: "Pirates", img: tPirates },
];

const appScreenshots = [
	{ src: s1, alt: "Simbi: Bedtime Stories — app screenshot 1" },
	{ src: s2, alt: "Simbi: Bedtime Stories — app screenshot 2" },
	{ src: s3, alt: "Simbi: Bedtime Stories — app screenshot 3" },
	{ src: s4, alt: "Simbi: Bedtime Stories — app screenshot 4" },
	{ src: s5, alt: "Simbi: Bedtime Stories — app screenshot 5" },
	{ src: s6, alt: "Simbi: Bedtime Stories — app screenshot 6" },
	{ src: s7, alt: "Simbi: Bedtime Stories — app screenshot 7" },
	{ src: s8, alt: "Simbi: Bedtime Stories — app screenshot 8" },
];
---

<Layout title="Simbi — Bedtime Stories Where Your Child is the Hero">
	<link
		slot="head"
		rel="preload"
		as="image"
		href={welcomeLcpPreload.src}
		type="image/webp"
	/>

<!-- ═══════════════════ NAV ═══════════════════ -->
<nav id="navbar" class="nav-bar fixed top-0 left-0 right-0 z-50 transition-[background,backdrop-filter,box-shadow] duration-500 ease-out">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-16 sm:h-[4.5rem]">
			<a href="#" class="flex items-center gap-2">
				<Image src={logoPng} alt="Simbi" class="h-8 sm:h-9 w-auto" width={logoPng.width} height={logoPng.height} />
			</a>
			<div class="hidden md:flex items-center gap-10">
				<a href="#how-it-works" class="text-[0.8125rem] font-display font-medium text-white/65 hover:text-white transition-colors duration-200 tracking-wide">How It Works</a>
				<a href="#app" class="text-[0.8125rem] font-display font-medium text-white/65 hover:text-white transition-colors duration-200 tracking-wide">The App</a>
				<a href="#faq" class="text-[0.8125rem] font-display font-medium text-white/65 hover:text-white transition-colors duration-200 tracking-wide">FAQ</a>
			</div>
			<a href="https://apps.apple.com" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-2 bg-white/[0.08] hover:bg-white/[0.14] border border-white/[0.08] text-white/90 hover:text-white font-display font-semibold text-[0.8125rem] px-5 py-2 rounded-full transition-all duration-200 backdrop-blur-sm">
				<svg class="w-[14px] h-[14px]" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
				Download Simbi
			</a>
			<button id="mobile-menu-btn" class="md:hidden p-2 text-white/65 hover:text-white transition-colors" aria-label="Menu">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
			</button>
		</div>
	</div>
	<div id="mobile-menu" class="md:hidden hidden bg-navy-950/95 backdrop-blur-2xl border-t border-white/[0.06]">
		<div class="px-5 py-5 space-y-1">
			<a href="#how-it-works" class="block text-white/70 hover:text-white py-2.5 font-display font-medium text-[0.9rem] transition-colors">How It Works</a>
			<a href="#app" class="block text-white/70 hover:text-white py-2.5 font-display font-medium text-[0.9rem] transition-colors">The App</a>
			<a href="#faq" class="block text-white/70 hover:text-white py-2.5 font-display font-medium text-[0.9rem] transition-colors">FAQ</a>
			<div class="pt-3">
				<a href="https://apps.apple.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-golden text-navy-950 font-display font-semibold text-sm px-5 py-2.5 rounded-full">
					<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
					Download Simbi
				</a>
			</div>
		</div>
	</div>
</nav>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section id="hero" class="relative z-20 min-h-[90vh] sm:min-h-screen flex items-start sm:items-center overflow-hidden pt-20 pb-12">
	<div id="hero-bg-parallax" class="hero-bg-parallax absolute inset-0 overflow-hidden">
		<Image
			src={mainBgPng}
			alt=""
			class="absolute inset-0 w-full h-full object-cover object-top sm:hidden"
			sizes="100vw"
			widths={[640, 750, 828, 1024, 1200, 1500, 2000]}
			quality="high"
		/>
		<Image
			src={newerBgJpg}
			alt=""
			class="absolute inset-0 w-full h-full object-cover object-[center_35%] hidden sm:block"
			sizes="100vw"
			widths={[1024, 1280, 1600, 1920, 2200, 2560]}
			quality="high"
		/>
		<div class="absolute inset-0 bg-gradient-to-b from-navy-950/20 via-navy-950/5 to-navy-950 lg:from-navy-950/10 lg:via-transparent lg:to-navy-950"></div>
	</div>

	<div class="stars-container absolute inset-0 pointer-events-none"></div>

	<!-- Left-weighted wash (like nav ~50% tone) fading to clear on the right for the artwork -->
	<div class="pointer-events-none absolute inset-0 z-[1] max-lg:bg-[linear-gradient(90deg,rgba(7,13,26,0.4)_0%,rgba(7,13,26,0.16)_42%,rgba(7,13,26,0.06)_58%,transparent_82%)] lg:bg-[linear-gradient(90deg,rgba(7,13,26,0.5)_0%,rgba(7,13,26,0.22)_36%,rgba(7,13,26,0.08)_50%,transparent_70%)]" aria-hidden="true"></div>

	<!-- Readability: extra vignette on small screens (stacked softly over the horizontal wash) -->
	<div class="pointer-events-none absolute inset-0 z-[1] lg:hidden bg-[radial-gradient(ellipse_100%_80%_at_50%_38%,rgba(7,13,26,0.28)_0%,rgba(7,13,26,0.1)_55%,transparent_78%)]" aria-hidden="true"></div>

	<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
		<!-- Mobile: full-bleed art above copy; z-20 so it paints over the headline area when overlapped -->
		<div class="sm:hidden relative z-20 left-1/2 -translate-x-1/2 w-screen max-w-[100vw] -mt-1 overflow-x-hidden pointer-events-none">
			<Image
				src={welcomePng}
				alt=""
				class="relative z-20 block h-auto w-full max-w-none align-bottom drop-shadow-[0_12px_40px_rgba(0,0,0,0.45)]"
				loading="eager"
				decoding="async"
				priority
				sizes="100vw"
				widths={[400, 600, 828, 1080, 1200, 1500, 2000]}
			/>
		</div>
		<div class="relative z-10 -mt-24 max-w-xl sm:max-w-2xl lg:max-w-[42rem] text-center lg:text-left mx-auto lg:mx-0 sm:mt-0">
			<div class="relative rounded-2xl sm:rounded-[1.6rem] border-0 sm:border-l sm:border-t sm:border-b sm:border-white/[0.05] border-r-0 shadow-none sm:shadow-[0_4px_36px_-12px_rgba(0,0,0,0.3)] px-5 py-7 sm:px-7 sm:py-8 lg:px-8 lg:py-9">
				<div class="hero-glass-blur hero-glass-fade-right pointer-events-none absolute inset-0 z-0 overflow-hidden rounded-[inherit] hidden sm:block" aria-hidden="true"></div>
				<div class="hero-glass-tint hero-glass-fade-right pointer-events-none absolute inset-0 z-0 overflow-hidden rounded-[inherit] hidden sm:block" aria-hidden="true"></div>
				<div class="relative z-10">
					<div class="space-y-4 sm:space-y-5 mb-7 sm:mb-8">
						<p class="animate-fade-in-up font-body text-base sm:text-lg lg:text-xl font-medium text-white/85 tracking-[0.02em] flex justify-center lg:justify-start lg:border-l-2 lg:border-golden/45 lg:pl-4">
							Simbi: Bedtime Stories
						</p>

						<h1 class="font-display font-bold text-[2rem] sm:text-[2.65rem] lg:text-[2.85rem] xl:text-[3.15rem] leading-[1.1] sm:leading-[1.08] animate-fade-in-up animation-delay-200 [text-shadow:0_2px_24px_rgba(7,13,26,0.85),0_1px_3px_rgba(7,13,26,0.9)]">
							Every Night, A Story
							<br />Made <span class="text-golden drop-shadow-[0_2px_16px_rgba(7,13,26,0.9)]">Just for Them</span>
						</h1>

						<p class="text-[0.95rem] sm:text-lg text-white/85 max-w-lg mx-auto lg:mx-0 leading-[1.6] sm:leading-relaxed animate-fade-in-up animation-delay-400 [text-shadow:0_1px_14px_rgba(7,13,26,0.75)]">
							Your child becomes the hero of their own bedtime adventure. Create their character, pick a world and a companion, and discover a fresh story together every night.
						</p>
					</div>

					<div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-5 justify-center lg:justify-start animate-fade-in-up animation-delay-600">
						<a href="https://apps.apple.com" target="_blank" rel="noopener noreferrer" class="group inline-flex w-full sm:w-auto items-center justify-center gap-3 bg-golden hover:bg-golden-dark text-navy-950 font-display font-bold text-base sm:text-lg px-7 py-3.5 rounded-full transition-all hover:scale-105 hover:shadow-[0_0_40px_rgba(245,166,35,0.3)]">
							<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
							Download Simbi
						</a>
						<a href="#how-it-works" class="flex items-center gap-2 text-white/65 hover:text-white font-display font-medium text-[0.9rem] transition-colors group">
							See how it works
							<svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="absolute top-0 left-0 right-0 h-36 sm:h-40 bg-gradient-to-b from-navy-950 to-transparent pointer-events-none z-[2]" aria-hidden="true"></div>
	<div class="absolute bottom-0 left-0 right-0 h-36 sm:h-40 bg-gradient-to-t from-navy-950 to-transparent pointer-events-none z-[2]" aria-hidden="true"></div>
</section>

<!-- Second site background: fades in after hero, parallax scroll (swap image per section later) -->
<div id="post-hero-parallax-stack" class="post-hero-parallax-stack fixed inset-0 z-[1] pointer-events-none overflow-hidden" aria-hidden="true">
	<div id="post-hero-parallax-inner" class="post-hero-parallax-inner">
		<Image
			src={secondBgPng}
			alt=""
			class="h-full w-full object-cover object-center"
			sizes="100vw"
			widths={[640, 1024, 1280, 1600, 2000, 2560]}
			quality="high"
		/>
	</div>
	<div class="absolute inset-0 bg-gradient-to-b from-navy-950/60 via-navy-900/40 to-navy-950/65"></div>
</div>

<div class="relative z-[2] bg-navy-950/80">

<!-- ═══════════════════ APP SCREENSHOTS (App Store strip) ═══════════════════ -->
<section id="app" class="relative pt-12 pb-16 sm:pt-16 sm:pb-24 lg:pb-28 overflow-hidden" aria-labelledby="app-screenshots-heading">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="mb-10 sm:mb-12" data-reveal>
			<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 sm:gap-6">
				<div class="text-center sm:text-left">
					<p class="text-golden font-display font-semibold text-sm tracking-widest uppercase mb-3">The app</p>
					<h2 id="app-screenshots-heading" class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl leading-tight">See Simbi on the App Store</h2>
					<p class="text-white/50 text-sm sm:text-base mt-3 max-w-xl mx-auto sm:mx-0 leading-relaxed">Real screens from the app — the same previews families see when they download.</p>
				</div>
				<p class="app-swipe-hint md:hidden flex items-center justify-center gap-2 text-sm text-white/45 font-display shrink-0">
					<span class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5">
						<svg class="w-4 h-4 text-golden/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg>
						Swipe for more
						<svg class="w-4 h-4 text-golden/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
					</span>
				</p>
			</div>
		</div>

		<div class="relative min-w-0">
			<!-- Edge fades (hint scroll) — aligned to same container as title -->
			<div class="pointer-events-none absolute inset-y-0 left-0 z-10 hidden sm:block w-5 bg-gradient-to-r from-[rgb(7,13,26)] to-transparent md:w-8" aria-hidden="true"></div>
			<div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-10 sm:w-12 bg-gradient-to-l from-[rgb(7,13,26)] to-transparent" aria-hidden="true"></div>

			<div
				class="app-screenshots-scroll w-full flex gap-3 sm:gap-4 md:gap-5 lg:gap-6 overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth pb-2 min-w-0"
				role="region"
				aria-label="App screenshot gallery. Swipe horizontally on a phone or tablet."
			>
				{appScreenshots.map((shot, i) => (
					<div class="flex-none snap-center app-screenshot-card">
						<div class="relative rounded-[1.35rem] sm:rounded-[1.5rem] overflow-hidden shadow-[0_16px_48px_rgba(0,0,0,0.45)] ring-1 ring-white/[0.12] bg-navy-900/40">
							<Image
								src={shot.src}
								alt={shot.alt}
								class="w-full h-auto block align-bottom select-none"
								loading={i < 3 ? "eager" : "lazy"}
								decoding="async"
								draggable={false}
								sizes="(min-width: 1280px) 260px, (min-width: 1024px) 240px, (min-width: 768px) 220px, (min-width: 640px) 200px, 32vw"
								widths={[200, 260, 400, 600, 800]}
								quality="high"
							/>
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<!-- ═══════════════════ HOW IT WORKS ═══════════════════ -->
<section id="how-it-works" class="relative py-16 sm:py-24 lg:py-28">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center mb-12 sm:mb-16" data-reveal>
			<p class="text-golden font-display font-semibold text-sm tracking-widest uppercase mb-3">How it works</p>
			<h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl">Bedtime in four simple steps</h2>
		</div>

		<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6" data-reveal="80ms">
			<div class="relative bg-white/[0.04] border border-white/[0.07] rounded-2xl p-6 text-center group hover:bg-white/[0.06] transition-colors">
				<span class="inline-block text-golden/50 font-display font-bold text-xs tracking-widest uppercase mb-4">Step 1</span>
				<h3 class="font-display font-bold text-lg mb-2">Build their character</h3>
