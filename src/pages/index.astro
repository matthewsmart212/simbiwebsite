<style>
	@keyframes fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes fade-in-up {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes gentle-float {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-10px); }
	}

	.animate-fade-in {
		animation: fade-in 0.8s ease-out both;
	}

	.animate-fade-in-up {
		animation: fade-in-up 0.8s ease-out both;
	}

	.animation-delay-200 {
		animation-delay: 200ms;
	}

	.animation-delay-400 {
		animation-delay: 400ms;
	}

	.animation-delay-600 {
		animation-delay: 600ms;
	}

	.hero-float {
		animation: gentle-float 6s ease-in-out infinite;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	/* ID alone beats .nav-scrolled — use combined selector so scroll state wins */
	.nav-bar:not(.nav-scrolled) {
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		box-shadow: none;
	}

	.nav-bar.nav-scrolled {
		background: rgba(7, 13, 26, 0.92);
		backdrop-filter: blur(24px) saturate(1.1);
		-webkit-backdrop-filter: blur(24px) saturate(1.1);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04), 0 4px 24px rgba(7, 13, 26, 0.45);
	}

	.reveal {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Hero copy panel: frosted fill fades out on the right (text stays sharp above) */
	.hero-glass-fade-right {
		-webkit-mask-image: linear-gradient(
			to right,
			#000 0%,
			#000 26%,
			rgba(0, 0, 0, 0.55) 36%,
			rgba(0, 0, 0, 0.18) 44%,
			transparent 50%,
			transparent 100%
		);
		mask-image: linear-gradient(
			to right,
			#000 0%,
			#000 26%,
			rgba(0, 0, 0, 0.55) 36%,
			rgba(0, 0, 0, 0.18) 44%,
			transparent 50%,
			transparent 100%
		);
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
		mask-mode: alpha;
		transform: translateZ(0);
	}

	.hero-glass-blur {
		background: rgba(7, 13, 26, 0.14);
		backdrop-filter: blur(14px) saturate(1.05);
		-webkit-backdrop-filter: blur(14px) saturate(1.05);
	}

	@media (min-width: 1024px) {
		.hero-glass-blur {
			background: rgba(7, 13, 26, 0.09);
			backdrop-filter: blur(10px) saturate(1.02);
			-webkit-backdrop-filter: blur(10px) saturate(1.02);
		}
	}

	.hero-glass-tint {
		background: linear-gradient(
			135deg,
			rgba(245, 166, 35, 0.07) 0%,
			transparent 50%
		);
	}

	.stars-container {
		background-image:
			radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.4) 0%, transparent 100%),
			radial-gradient(1px 1px at 30% 60%, rgba(255,255,255,0.3) 0%, transparent 100%),
			radial-gradient(1.5px 1.5px at 50% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
			radial-gradient(1px 1px at 70% 40%, rgba(255,255,255,0.35) 0%, transparent 100%),
			radial-gradient(1px 1px at 90% 80%, rgba(255,255,255,0.3) 0%, transparent 100%),
			radial-gradient(1.5px 1.5px at 15% 85%, rgba(255,255,255,0.45) 0%, transparent 100%),
			radial-gradient(1px 1px at 85% 15%, rgba(255,255,255,0.35) 0%, transparent 100%),
			radial-gradient(1px 1px at 45% 75%, rgba(255,255,255,0.3) 0%, transparent 100%);
	}

	.no-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}

	/* App Store–style strip; card width is share of the scroll container (matches title column width) */
	.app-screenshots-scroll {
		/* Matches Tailwind gap-* on the flex row; used so ~3 cards fit the container width */
		--app-shot-gap: 0.75rem;
	}

	.app-screenshot-card {
		width: calc((100% - 2 * var(--app-shot-gap)) / 3.12);
		max-width: 300px;
	}

	@media (min-width: 640px) {
		.app-screenshots-scroll {
			--app-shot-gap: 1rem;
		}

		.app-screenshot-card {
			width: 200px;
			max-width: none;
		}
	}

	@media (min-width: 768px) {
		.app-screenshots-scroll {
			--app-shot-gap: 1.25rem;
		}

		.app-screenshot-card {
			width: 220px;
		}
	}

	@media (min-width: 1024px) {
		.app-screenshots-scroll {
			--app-shot-gap: 1.5rem;
		}

		.app-screenshot-card {
			width: 240px;
		}
	}

	@media (min-width: 1280px) {
		.app-screenshot-card {
			width: 260px;
		}
	}

	@media (max-width: 767px) {
		.app-swipe-hint {
			animation: app-swipe-hint-glow 2.8s ease-in-out infinite;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.app-swipe-hint {
			animation: none;
		}
	}

	@keyframes app-swipe-hint-glow {
		0%,
		100% {
			opacity: 0.75;
		}
		50% {
			opacity: 1;
		}
	}

	.hero-bg-parallax {
		will-change: transform;
	}

	.post-hero-parallax-stack {
		opacity: 0;
		transition: opacity 0.6s ease-out;
	}

	.post-hero-parallax-stack.visible {
		opacity: 1;
	}

	.post-hero-parallax-inner {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	const navbar = document.getElementById('navbar');
	const onScroll = () => {
		if (!navbar) return;
		navbar.classList.toggle('nav-scrolled', window.scrollY > 50);
	};
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	/* Second background fades in once, then stays permanently */
	const heroEl = document.getElementById('hero');
	const postStack = document.getElementById('post-hero-parallax-stack');
	let secondBgLocked = false;

	const checkSecondBg = () => {
		if (secondBgLocked || !heroEl || !postStack) return;
		const heroH = heroEl.offsetHeight;
		if (window.scrollY >= heroH * 0.65) {
			postStack.classList.add('visible');
			secondBgLocked = true;
		}
	};

	window.addEventListener('scroll', checkSecondBg, { passive: true });
	checkSecondBg();

	const menuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');
	menuBtn?.addEventListener('click', () => {
		mobileMenu?.classList.toggle('hidden');
	});

	mobileMenu?.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', () => {
			mobileMenu?.classList.add('hidden');
		});
	});

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('visible');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

	document.querySelectorAll('[data-reveal]').forEach((el) => {
		el.classList.add('reveal');
		const delay = el.dataset.reveal;
		if (delay) el.style.transitionDelay = delay;
		observer.observe(el);
	});
</script>
